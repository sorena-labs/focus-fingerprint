{
  "name": "focus-fingerprint",
  "version": "0.3.0",
  "description": "Find the element that had focus again after its part of the page is drawn again, so focus can go back to it instead of falling to the body.",
  "keywords": [
    "focus",
    "focus-management",
    "restore-focus",
    "return-focus",
    "accessibility",
    "a11y",
    "keyboard",
    "dom"
  ],
  "license": "MIT",
  "author": "Sorena Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorena-labs/focus-fingerprint.git"
  },
  "bugs": "https://github.com/sorena-labs/focus-fingerprint/issues",
  "homepage": "https://github.com/sorena-labs/focus-fingerprint#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.json --removeComments --declaration false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
